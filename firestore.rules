rules_version = '2';

// AI 리터러시 수업 웹앱 — Firestore 보안 규칙
// 허용 경로: groups/{1~4}, groups/{1~4}/members/{1~5}, judge/{사례id}, board/summary
// 모둠 수·인원을 바꾸면 isGroup / isMember 와 js/common.js, js/db.js 를 같이 고친다.
// 그 외 경로는 규칙이 없으므로 전부 차단된다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isGroup(g)  { return g in ['1', '2', '3', '4']; }
    function isMember(m) { return m in ['1', '2', '3', '4', '5']; }
    function isCaseId(id) { return id.matches('^[A-Za-z0-9_-]{1,40}$'); }

    function isText(v)  { return v is string && v.size() <= 300; }
    function isTime(v)  { return v is number && v > 0; }
    function isCount(v) { return v is int && v >= 0 && v <= 999; }

    // 모둠 정리 문서: strength, limit, updatedAt 세 필드만
    function validThought() {
      let d = request.resource.data;
      return d.keys().hasOnly(['strength', 'limit', 'updatedAt'])
          && d.keys().hasAll(['strength', 'limit', 'updatedAt'])
          && isText(d.strength)
          && isText(d.limit)
          && isTime(d.updatedAt);
    }

    function isDeviceId(v) { return v is string && v.matches('^[A-Za-z0-9-]{8,64}$'); }

    function isName(v) { return v is string && v.size() >= 1 && v.size() <= 10; }  // 이름(성 빼고)

    // 개인 생각 문서: 이름 + 글(strength, limit, updatedAt) + 고른 기기(claimedBy, claimedAt)
    // 번호만 고른 상태({name, claimedBy, claimedAt})도 있으므로 각 필드는 있을 때만 검사
    // 번호를 고른 상태(claimedBy 있음)면 이름도 꼭 있어야 한다
    function validMember() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'strength', 'limit', 'updatedAt', 'claimedBy', 'claimedAt'])
          && (!('name' in d) || isName(d.name))
          && (!('claimedBy' in d) || ('name' in d))
          && (!('strength' in d) || isText(d.strength))
          && (!('limit' in d) || isText(d.limit))
          && (!('updatedAt' in d) || isTime(d.updatedAt))
          && (!('claimedBy' in d) || isDeviceId(d.claimedBy))
          && (!('claimedAt' in d) || isTime(d.claimedAt));
    }

    // 고른 기기는 다른 기기로 바꿀 수 없다.
    // 허용: 처음 고르기(기존 claimedBy 없음) / 그대로 두기 / 선택 풀기(claimedBy 지우기 — 교사 [선택 풀기])
    function claimKept() {
      return !('claimedBy' in resource.data)
          || !('claimedBy' in request.resource.data)
          || request.resource.data.claimedBy == resource.data.claimedBy;
    }

    // 글(strength, limit, updatedAt)을 새로 쓰거나 바꾸는 쓰기는
    // 이 번호를 고른 기기(claimedBy)가 기존 문서와 새 문서에 모두 있고 같을 때만 허용.
    // → 선택이 풀린 뒤(교사 [선택 풀기]·모둠 초기화) 옛 화면에서 저장하면 거절된다.
    // 선택 풀기(claimedBy/claimedAt만 지우기)와 이야기 고르기(claimedBy/claimedAt만 쓰기)는 글을 건드리지 않으므로 해당 없음.
    function writesThought() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['strength', 'limit', 'updatedAt']);
    }
    function sameClaimer() {
      return ('claimedBy' in resource.data)
          && ('claimedBy' in request.resource.data)
          && request.resource.data.claimedBy == resource.data.claimedBy;
    }
    // 새 문서는 번호 고르기({name, claimedBy, claimedAt})로만 만든다 (글이 든 문서를 바로 만들 수 없음)
    function createsClaimOnly() {
      return !request.resource.data.keys().hasAny(['strength', 'limit', 'updatedAt']);
    }
    // 이름을 바꾸는 쓰기는 이 번호를 고른 기기만 (같은 기기) 또는 비어 있는 번호를 새로 고를 때만
    function writesName() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']);
    }
    function claimingNow() {
      return !('claimedBy' in resource.data) && ('claimedBy' in request.resource.data);
    }

    // O/X 기록 문서: firstO, firstX, finalO, finalX, updatedAt (+ rev: 바뀐 횟수)
    function validJudge() {
      let d = request.resource.data;
      return d.keys().hasOnly(['firstO', 'firstX', 'finalO', 'finalX', 'updatedAt', 'rev'])
          && d.keys().hasAll(['firstO', 'firstX', 'finalO', 'finalX', 'updatedAt'])
          && isCount(d.firstO) && isCount(d.firstX)
          && isCount(d.finalO) && isCount(d.finalX)
          && isTime(d.updatedAt)
          && (!('rev' in d) || (d.rev is int && d.rev >= 0));
    }

    // 모둠 정리
    match /groups/{g} {
      allow get: if isGroup(g);
      allow list: if true;                       // groups 컬렉션 실시간 보기(교사)
      allow create, update: if isGroup(g) && validThought();
      allow delete: if isGroup(g);

      // 개인 생각
      match /members/{m} {
        allow get: if isGroup(g) && isMember(m);
        allow list: if isGroup(g);
        allow create: if isGroup(g) && isMember(m) && validMember() && createsClaimOnly();
        allow update: if isGroup(g) && isMember(m) && validMember() && claimKept()
                      && (!writesThought() || sameClaimer())
                      && (!writesName() || sameClaimer() || claimingNow());
        allow delete: if isGroup(g);              // 초기화, 글 없는 선택 바꾸기, 남은 문서 정리
      }
    }

    // 정리 판서 board/summary: 칸마다 항목 10개까지, 키워드 30자·설명 80자·핵심 문장 150자, 모둠 태그 1~4
    // (규칙에는 반복문이 없어서 0~9번 항목을 하나씩 검사한다)
    function validItem(list, i) {
      return i >= list.size() || (
        list[i] is map
        && list[i].keys().hasOnly(['id', 'keyword', 'desc', 'groups'])
        && list[i].keys().hasAll(['id', 'keyword', 'desc', 'groups'])
        && list[i].id is string && list[i].id.size() >= 1 && list[i].id.size() <= 24
        && list[i].keyword is string && list[i].keyword.size() >= 1 && list[i].keyword.size() <= 30
        && list[i].desc is string && list[i].desc.size() <= 80
        && list[i].groups is list && list[i].groups.size() <= 4 && list[i].groups.hasOnly([1, 2, 3, 4])
      );
    }
    function validItems(list) {
      return list is list && list.size() <= 10
          && validItem(list, 0) && validItem(list, 1) && validItem(list, 2) && validItem(list, 3) && validItem(list, 4)
          && validItem(list, 5) && validItem(list, 6) && validItem(list, 7) && validItem(list, 8) && validItem(list, 9);
    }
    function validBoard() {
      let d = request.resource.data;
      return d.keys().hasOnly(['abilities', 'limits', 'conclusion', 'updatedAt', 'rev'])
          && d.keys().hasAll(['abilities', 'limits', 'conclusion', 'updatedAt', 'rev'])
          && validItems(d.abilities)
          && validItems(d.limits)
          && d.conclusion is string && d.conclusion.size() <= 150
          && isTime(d.updatedAt)
          && d.rev is int && d.rev >= 0;
    }

    match /board/{id} {
      allow get, list: if true;
      allow create, update: if id == 'summary' && validBoard();
      allow delete: if true;                     // 전체 초기화
    }

    // AI 활용 판단 O/X 기록
    match /judge/{id} {
      allow get: if isCaseId(id);
      allow list: if true;
      allow create, update: if isCaseId(id) && validJudge();
      allow delete: if true;
    }
  }
}
